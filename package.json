{
  "name": "unraid-deck-bridge",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.23.1 <23",
    "npm": ">=10.9.8 <11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/prepare-build.mjs",
    "test": "npm run build && node scripts/schema.mjs --check && node --test tests/*.test.mjs",
    "schema": "npm run build && node scripts/schema.mjs",
    "prepackage": "npm run build",
    "package": "node scripts/package.mjs",
    "format": "prettier --write 'api-extension/*.ts' 'scripts/*.mjs' 'packaging/*.mjs' 'tests/**/*.mjs' && shfmt -w -i 2 -ci packaging/*.sh packaging/rc.unraid-deck-bridge",
    "format:check": "prettier --check 'api-extension/*.ts' 'scripts/*.mjs' 'packaging/*.mjs' 'tests/**/*.mjs' && shfmt -d -i 2 -ci packaging/*.sh packaging/rc.unraid-deck-bridge",
    "compatibility:audit": "node scripts/audit-compatibility.mjs",
    "preruntime:check": "npm run build",
    "runtime:check": "node scripts/check-host-runtimes.mjs"
  },
  "peerDependencies": {
    "@nestjs/common": "11.1.26",
    "@nestjs/core": "11.1.26",
    "@nestjs/graphql": "13.4.2",
    "@unraid/shared": "4.25.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "graphql": "16.11.0",
    "graphql-scalars": "1.24.2",
    "reflect-metadata": "^0.1.14",
    "rxjs": "7.8.2"
  },
  "peerDependenciesMeta": {
    "@unraid/shared": {
      "optional": true
    }
  },
  "devDependencies": {
    "@graphql-tools/utils": "10.9.1",
    "@nestjs/common": "11.1.26",
    "@nestjs/core": "11.1.26",
    "@nestjs/graphql": "13.4.2",
    "@types/node": "22.18.0",
    "@unraid/shared": "file:vendor/unraid-shared-4.25.3.tgz",
    "@xmldom/xmldom": "0.9.12",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fs-native-extensions": "1.5.2",
    "graphql": "16.11.0",
    "graphql-scalars": "1.24.2",
    "nest-authz": "2.17.0",
    "prettier": "3.6.2",
    "reflect-metadata": "^0.1.14",
    "rxjs": "7.8.2",
    "tar-stream": "3.2.2",
    "typescript": "5.9.2"
  },
  "overrides": {
    "ws": "8.21.0",
    "csv-parse": "7.0.2"
  },
  "bridge": {
    "pluginVersion": "2026.10.28.0006"
  }
}
